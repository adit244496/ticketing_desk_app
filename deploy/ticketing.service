# Hospi Ticketing Desk - gunicorn (Flask WSGI) systemd unit
#
# Install:
#   sudo cp deploy/ticketing.service /etc/systemd/system/ticketing.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ticketing
#
# NOTE: --workers 1 is intentional. app.py starts an in-process background
# thread (SLA checks / escalations / auto-close). More than one worker would
# run that loop multiple times -> duplicate escalations and duplicate emails.

[Unit]
Description=Hospi Ticketing Desk - Flask API
After=network.target

[Service]
User=srvadmin
Group=srvadmin
EnvironmentFile=/media/DataDisk/app/ticketing/backend/.env
Environment="PATH=/media/DataDisk/app/ticketing/backend/venv/bin"
WorkingDirectory=/media/DataDisk/app/ticketing/backend/data
ExecStart=/media/DataDisk/app/ticketing/backend/venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 0.0.0.0:8000 \
    --timeout 120 \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
